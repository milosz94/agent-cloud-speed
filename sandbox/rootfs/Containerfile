# Agent microVM rootfs: everything an agent needs to operate ONE cloud, nothing cloud-specific baked in.
# Credentials (scoped, per-run) and the task are injected at boot via a second drive, never baked here.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git jq openssh-client \
      python3 python3-venv python3-pip \
      iproute2 iputils-ping dnsutils \
      systemd systemd-sysv \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 (agent CLI runtime) + BOTH supported agent CLIs. Both are installed unconditionally:
# which one runs is a per-job choice (job drive's agent.txt), not an image variant, so one image
# serves every run and the agent axis stays switchable without a rebuild.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code @openai/codex \
    && rm -rf /var/lib/apt/lists/*

# uv / uvx (runs the AWS MCP proxy `uvx mcp-proxy-for-aws`, and any other MCP a cloud needs)
RUN curl -fsSL https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# non-root user to run the agent as (Claude Code refuses --dangerously-skip-permissions as root).
# uid 1000 is already taken by ubuntu:24.04's 'ubuntu' user, so let useradd pick the next free uid.
RUN useradd -m -s /bin/bash agent && id agent

# the in-VM runner: reads the injected job (task + scoped creds + mcp config) off /dev/vdb,
# runs the agent headless, writes the result + transcript back to /dev/vdb, then powers off.
COPY vm-runner.sh /usr/local/bin/vm-runner
RUN chmod +x /usr/local/bin/vm-runner

# smoke marker so a boot test can confirm the toolchain without a job drive
RUN claude --version > /etc/claude-version 2>&1 || true; \
    codex --version  > /etc/codex-version  2>&1 || true; \
    node --version   > /etc/node-version   2>&1 || true
